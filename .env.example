# Copy to .env and fill in only the providers you use. Two or more agents need working keys.
# Keys can also be added from the web app (Settings → API keys); they are stored locally in
# ~/.outreach-studio/keys.json with owner-only permissions. Never commit real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: higher GitHub rate limits for the developer-profile analysis (no scopes needed for public repos)
GITHUB_TOKEN=

# Optional web search for recipient research (pick one in agents.yaml → search.provider)
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional locations
# OUTREACH_DATA_DIR=~/.outreach-studio
# OUTREACH_CONFIG=~/.outreach-studio/agents.yaml
